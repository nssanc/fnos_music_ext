# Copy this file to .env and fill in values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

FNMUSIC_HOME=

# Python package mirror used while building Docker images and host venvs.
# Mainland China example: https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple
FNMUSIC_INSTALL_MODE=docker

# Sources: enable at least one search source (install.sh --sources musicdl,musicbox,qqmusic,lx)
# musicdl: https://github.com/CharlesPikachu/musicdl
# musicbox: https://github.com/darknessomi/musicbox
# lxmusic: 洛雪音乐源（免登录解析：酷狗 kg / 网易 wy / 咪咕 mg，高音质直链）
FNMUSIC_MUSICDL_ENABLED=true
FNMUSIC_NETEASE_ENABLED=true
FNMUSIC_MUSICDL_URL=http://127.0.0.1:8768
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
FNMUSIC_QQMUSIC_ENABLED=true
FNMUSIC_QQMUSIC_URL=http://127.0.0.1:8771
FNMUSIC_QQMUSIC_SEARCH_LIMIT=50
FNMUSIC_QQMUSIC_QUALITY=F000
FNMUSIC_LX_SOURCE_ENABLED=true
FNMUSIC_LX_SOURCE_URL=http://127.0.0.1:8772
FNMUSIC_SOURCE_CONFIG=
FNMUSIC_ONLINE_SOURCES=MiguMusicClient,KuwoMusicClient
FNMUSIC_ONLINE_LIMIT=100
FNMUSIC_MERGE_SUGGEST=true
FNMUSIC_NETEASE_SEARCH_LIMIT=100
FNMUSIC_MUSICDL_SEARCH_LIMIT=100

# 洛雪聚合搜索服务 lxmusic（与 8772 自定义脚本运行器并存）
FNMUSIC_LX_ENABLED=true
FNMUSIC_LX_URL=http://127.0.0.1:8773
FNMUSIC_LX_SEARCH_LIMIT=50
FNMUSIC_LX_QUALITY=lossless
FNMUSIC_DEPLOY_MODE=docker

# Daily recommend (OpenAI-compatible). Leave empty to disable.
FNMUSIC_LLM_BASE_URL=
FNMUSIC_LLM_API_KEY=
FNMUSIC_LLM_MODEL=gpt-4o-mini
